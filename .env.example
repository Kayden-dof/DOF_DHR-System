# 원격 배포용 값은 .env.deploy 에 둔다 (npm run deploy:db 가 읽는다).
# 로컬 개발용 .env.local 은 npm run dev 가 자동 생성하므로 손댈 필요 없다.
# 둘 다 커밋되지 않는다.

# Supabase 대시보드 → Connect
#   마이그레이션(scripts/deploy-db.mjs) : Session pooler, 포트 5432
#   Vercel 런타임                        : Transaction pooler, 포트 6543
# 로컬 개발(npm run dev)은 scripts/dev.mjs 가 이 값을 자동으로 덮어쓴다.
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres

# 마이그레이션용 접속을 따로 쓰고 싶을 때만 (없으면 DATABASE_URL 사용)
# MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# 세션 서명 키. 32자 이상. 바뀌면 로그인된 세션이 전부 끊긴다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 인쇄물 자료 식별자 서명 키. 반드시 넣을 것.
#   비워 두면 SESSION_SECRET 에서 파생한다. 그 상태로 세션 키를 갈면 같은
#   자료가 다른 식별자를 내어, 자료가 그대로인데도 바뀐 뒤에 다시 뽑은 것으로
#   읽힌다. 지금 쓰고 있는 파생 열쇠를 그대로 고정하려면
#     node scripts/print-key.mjs
#   찍힌 64자 16진수를 그대로 넣는다. 넣어도 기존 인쇄물의 식별자는 그대로다.
#   한 번 넣으면 갈지 말 것.
# PRINT_SECRET=

# 시연 자료의 비밀번호를 고정하고 싶을 때만 (없으면 시드할 때마다 무작위)
# DEMO_PIN=

# 인증서 검증을 끄려면 1 (권장하지 않음. 끄기 전에 원인을 볼 것)
# PGSSL_NO_VERIFY=

# 접속지 제한 (망 경계). 비어 있으면 어디서나 접속할 수 있다.
#   제조소 공인 IP 를 넣으면 그 자리에서만 열린다. 쉼표나 공백으로 여러 개.
#   구간 표기(CIDR)도 된다. IPv6 도 같은 칸에 섞어 적는다.
#     ALLOW_FROM=203.0.113.9, 203.0.113.0/24, 2001:db8::/32
#
#   이것은 두 겹 중 **안쪽 겹**이다. 바깥 겹은 Vercel 방화벽이고, 거기서
#   먼저 끊어야 우리 서버까지 오지도 않는다. 두 곳에 같은 값을 넣는다.
#
#   목록에 없는 자리는 막는다. 접속지를 읽지 못한 요청도 막는다 - 목록을
#   적은 뜻은 "이 자리들만" 이고, 머리글 하나 지운 요청에 문이 열리면
#   목록이 뜻을 잃는다. 풀려면 이 값을 지운다 (앱 안에 푸는 단추는 없다).
#
#   **배포 환경에 넣는 값이다.** 로컬 .env.local 에 넣으면 개발 서버도
#   함께 막힌다 (localhost 는 자기 주소 ::1 로 온다). 로컬에서 시험하려면
#   ALLOW_FROM=::1,127.0.0.1 처럼 적어 두고 쓴다.
# ALLOW_FROM=

# 접속지의 나라. 두 글자 코드. 쉼표로 여러 개.
#     ALLOW_COUNTRY=KR
#
#   공인 IP 가 유동이면 ALLOW_FROM 목록은 바뀔 때마다 사람이 고쳐야 하고,
#   고치기 전까지 제조소가 잠긴다. **나라는 주소가 바뀌어도 안 바뀐다.**
#
#   Vercel 이 IP 를 보고 채운 머리글(x-vercel-ip-country)에서 읽는다.
#   브라우저가 보내는 값이 아니라 지어낼 수 없다 - 브라우저 위치(GPS)를
#   쓰지 않는 이유가 이것이다. 그 좌표는 브라우저가 보내므로 코드를 쥔
#   사람이 제조소 좌표를 지어 보내면 그대로 통과한다.
#
#   **이것은 경계가 아니라 걸러 내기다.** 한국 안이면 전부 통과한다.
#   전 세계에서 한국으로 줄이는 것이지 제조소만 남기는 것이 아니다.
#
#   ALLOW_FROM 과 함께 적으면 **둘 다** 맞아야 열린다. 하나만 맞아도 열어
#   주면 넓은 쪽이 좁은 쪽을 무르게 만든다.
# ALLOW_COUNTRY=

# 예약 작업(/api/daily) 열쇠. 접속지 제한을 지나가는 유일한 길이라 반드시 넣는다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Vercel 프로젝트 설정에 넣으면 예약 작업이 자동으로 Bearer 로 붙여 보낸다.
# CRON_SECRET=
