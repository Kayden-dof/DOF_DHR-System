# 원격 배포용 값은 .env.deploy 에 둔다 (npm run deploy:db 가 읽는다).
# 로컬 개발용 .env.local 은 npm run dev 가 자동 생성하므로 손댈 필요 없다.
# 둘 다 커밋되지 않는다.

# Supabase 대시보드 → Connect
#   마이그레이션(scripts/deploy-db.mjs) : Session pooler, 포트 5432
#   Vercel 런타임                        : Transaction pooler, 포트 6543
# 로컬 개발(npm run dev)은 scripts/dev.mjs 가 이 값을 자동으로 덮어쓴다.
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres

# 마이그레이션용 접속을 따로 쓰고 싶을 때만 (없으면 DATABASE_URL 사용)
# MIGRATION_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# 세션 서명 키. 32자 이상. 바뀌면 로그인된 세션이 전부 끊긴다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 인쇄물 자료 식별자 서명 키. 반드시 넣을 것.
#   비워 두면 SESSION_SECRET 에서 파생한다. 그 상태로 세션 키를 갈면 같은
#   자료가 다른 식별자를 내어, 자료가 그대로인데도 바뀐 뒤에 다시 뽑은 것으로
#   읽힌다. 지금 쓰고 있는 파생 열쇠를 그대로 고정하려면
#     node scripts/print-key.mjs
#   찍힌 64자 16진수를 그대로 넣는다. 넣어도 기존 인쇄물의 식별자는 그대로다.
#   한 번 넣으면 갈지 말 것.
# PRINT_SECRET=

# 시연 자료의 비밀번호를 고정하고 싶을 때만 (없으면 시드할 때마다 무작위)
# DEMO_PIN=

# 인증서 검증을 끄려면 1 (권장하지 않음. 끄기 전에 원인을 볼 것)
# PGSSL_NO_VERIFY=
