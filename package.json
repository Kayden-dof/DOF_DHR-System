{
  "name": "dof-dhr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DOF DHR 지원 시스템 - M0 (사용자/권한/감사추적/채번)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:reset": "node -e \"require('fs').rmSync('.pgdata-dev',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-sql-params.mjs && node test/run.mjs",
    "check:sql": "node scripts/check-sql-params.mjs",
    "test:print": "node --env-file=.env.local test/print.mjs",
    "test:mutation": "node test/mutation.mjs",
    "test:restore": "node --env-file=.env.local test/restore-gate.mjs",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "fresh": "node --env-file=.env.local scripts/fresh-check.mjs",
    "access": "node --env-file=.env.local scripts/access-matrix.mjs",
    "test:pg": "node test/pg.mjs",
    "test:concurrency": "node test/concurrency.mjs",
    "deploy:db": "node scripts/deploy-db.mjs",
    "backup": "node --env-file=.env.deploy scripts/backup.mjs",
    "backup:local": "node scripts/backup.mjs --local",
    "restore:check": "node scripts/restore-check.mjs",
    "ca:sync": "node scripts/ca-sync.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:flow": "node scripts/seed-flow.mjs",
    "demo": "node scripts/demo.mjs",
    "set-pin": "node scripts/set-pin.mjs",
    "schema:baseline": "node --env-file=.env.local scripts/schema-baseline.mjs"
  },
  "dependencies": {
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "embedded-postgres": "17.6.0-beta.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
